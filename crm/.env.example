# Shared secret for Streamlit / admin API calls (send as X-API-Key header)
CRM_API_KEY=change-me-to-a-long-random-string

# Comma-separated origins allowed to POST public lead intake
CRM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://nuvueprod.com,https://www.nuvueprod.com,null

# Optional override; default is crm/data/nuvue_crm.db
# CRM_DATABASE_URL=sqlite:///./data/nuvue_crm.db

# Web3Forms access key (server-side only — used by POST /api/leads to send email)
# Get a key at https://web3forms.com — do not put this in website HTML/JS
WEB3FORMS_ACCESS_KEY=
# WEB3FORMS_SUBJECT=New NuVue Media contact form message
# WEB3FORMS_FROM_NAME=NuVue Media Website
